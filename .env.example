# Optional: copy to .env to override defaults. Everything runs without it.
# Docker Compose reads this file; the values below are the defaults.

POSTGRES_USER=patients
# Must be URL-safe (no @ : / ? #): it is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=patients
POSTGRES_DB=patients

# Host ports
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173